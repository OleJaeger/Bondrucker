{
  "name": "n8n-nodes-bondrucker",
  "version": "0.1.0",
  "description": "n8n community node for the Bondrucker ESC/POS thermal-printer REST API",
  "keywords": [
    "n8n-community-node-package",
    "bondrucker"
  ],
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc && node_modules/.bin/gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials test --write",
    "lint": "eslint nodes credentials --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BondruckerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Bondrucker/Bondrucker.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.60.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
